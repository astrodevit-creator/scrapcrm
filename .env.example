# ScrapCRM — environment configuration (copy to .env)
# All values are placeholders. No real credentials are included.

# SQLite database file path
SCRAPCRM_DB=./scrapcrm.db

# Comma-separated niches to focus lead discovery on
SCR_LIVE=false
SCRAPCRM_NICHES=golf,padel,coffee,skincare,activewear,jewelry,food,pet

# Optional: path to a local Scrapling (Python) helper script
SCRAPLING_PY=

# Debug mode (true/false)
SCRAPCRM_DEBUG=false
